{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patent-docent.local/contracts/schemas/figures-manifest.schema.json",
  "title": "figures-manifest/v0",
  "$comment": "도면 자산층 매니페스트 `30-figures/assets/manifest.json`(SPEC §1.8 · §7.5 · 재정 R11 · 재정 2026-09-13 T65 ③). 항목 = §7.5 의 10키 + asset_id·source_sha256(총괄 재량 ⓒ — 자산 id 와 원천 지문을 매니페스트가 들어야 selection·gate 가 basename 을 추정하지 않는다). edit_class ↔ publishable 의 대응은 SPEC §7.5 표(재정 R11)이며 여기서 if/then 으로 집행한다. 자산 파일의 삭제·덮어쓰기 금지(§7.5)는 스키마 밖 — 러너(engine/stages/figures.py) 규율이다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "spec_version", "spec_digest", "renderer", "items"],
  "properties": {
    "schema": { "const": "figures-manifest/v0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9]+-[a-z0-9-]+$" },
    "spec_version": { "type": "integer", "minimum": 1 },
    "spec_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "renderer": {
      "$comment": "렌더 환경 실측(총괄 실측 2026-09-13 · 발주문 ④). 값은 러너가 환경에서 읽어 적는다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "playwright", "browser", "channel", "viewport", "device_scale_factor"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "playwright": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "device_scale_factor": { "type": "integer", "minimum": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id", "source_raw_path", "source_sha256", "asset_id", "asset_path", "sha256",
        "renderer", "template", "fallback", "edits", "edit_class", "publishable", "rendered_at"
      ],
      "properties": {
        "figure_id": { "type": "string", "pattern": "^FIG-[A-Za-z0-9-]+$" },
        "source_raw_path": { "type": "string", "pattern": "^00-source/figures-raw/[^/]+$" },
        "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "asset_id": { "type": "string", "pattern": "^fig-[0-9]{2,}(?:\\.r[1-9][0-9]*)?$" },
        "asset_path": { "type": "string", "pattern": "^30-figures/assets/fig-[0-9]{2,}(?:\\.r[1-9][0-9]*)?\\.png$" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "renderer": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "fallback": { "type": "boolean" },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": { "op": { "type": "string", "minLength": 1 } }
          }
        },
        "edit_class": { "enum": ["crop-only", "self-authored", "annotated-internal", "recomposed-internal"] },
        "publishable": { "type": "boolean" },
        "rendered_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      },
      "allOf": [
        {
          "$comment": "SPEC §7.5 표(재정 R11): crop-only · self-authored → publishable true.",
          "if": { "properties": { "edit_class": { "enum": ["crop-only", "self-authored"] } } },
          "then": { "properties": { "publishable": { "const": true } } }
        },
        {
          "$comment": "SPEC §7.5 표(재정 R11): annotated-internal · recomposed-internal → publishable false(사용권 재정 전 게시 보류).",
          "if": { "properties": { "edit_class": { "enum": ["annotated-internal", "recomposed-internal"] } } },
          "then": { "properties": { "publishable": { "const": false } } }
        }
      ]
    }
  }
}
